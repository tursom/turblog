# Astro / GitHub Actions
PUBLIC_SITE_URL=http://localhost:4321

# Blog container and shared public port
BLOG_IMAGE=ghcr.io/tursom/turblog
BLOG_VERSION=latest
BLOG_PORT=8080

# Book chapter access (generate the password with: openssl rand -base64 32)
TURBLOG_BOOK_ACCESS_PASSWORD=replace-with-a-long-private-password

# Anonymous visitor hashing (generate with: openssl rand -hex 32)
TURBLOG_VISITOR_HASH_KEY=replace-with-at-least-32-random-bytes

# VPS webhook deployment
WATCHTOWER_HTTP_API_TOKEN=replace-with-a-long-random-token

# DEPLOY_WEBHOOK_URL and DEPLOY_WEBHOOK_TOKEN belong in GitHub Secrets.
