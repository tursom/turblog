# Astro / GitHub Actions
PUBLIC_SITE_URL=http://localhost:4321

# Blog container
BLOG_IMAGE=ghcr.io/tursom/turblog
BLOG_VERSION=latest
BLOG_PORT=8080

# VPS webhook deployment
WATCHTOWER_PORT=8090
WATCHTOWER_HTTP_API_TOKEN=replace-with-a-long-random-token

# DEPLOY_WEBHOOK_URL and DEPLOY_WEBHOOK_TOKEN belong in GitHub Secrets.
