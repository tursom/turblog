---
import { getCollection, render } from 'astro:content';
import SiteLayout from '@/layouts/SiteLayout.astro';
import BookChapterViewCounts from '@/components/BookChapterViewCounts.astro';
import BookReaderNav from '@/components/BookReaderNav.astro';
import BookShareButton from '@/components/BookShareButton.astro';
import BookToc from '@/components/BookToc.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import {
  bookPath,
  getBookChapters,
  parallelChapterPath,
  type Book,
  type BookChapter,
} from '@/lib/books';
import { readingMinutes } from '@/lib/posts';

export async function getStaticPaths() {
  const books = await getCollection('books');
  return (
    await Promise.all(
      books.map(async (book) => {
        const bookChapters = await getBookChapters(book.data.slug);
        return bookChapters.map((chapter, index) => ({
          params: { bookSlug: book.data.slug, chapterSlug: chapter.data.slug },
          props: {
            book,
            chapters: bookChapters,
            chapter,
            previous: bookChapters[index - 1],
            next: bookChapters[index + 1],
          },
        }));
      }),
    )
  ).flat();
}

interface Props {
  book: Book;
  chapters: BookChapter[];
  chapter: BookChapter;
  previous?: BookChapter;
  next?: BookChapter;
}

const { book, chapters, chapter, previous, next } = Astro.props;
const { Content, headings } = await render(chapter);
const readingTime = readingMinutes(chapter.body ?? '');
const titleFootnote = chapter.data.titleFootnote;
const titleStart = titleFootnote
  ? chapter.data.title.slice(0, titleFootnote.offset)
  : chapter.data.title;
const titleEnd = titleFootnote ? chapter.data.title.slice(titleFootnote.offset) : '';
const pageTitle = `${chapter.data.title} · ${book.data.title}`;
---

<SiteLayout
  title={pageTitle}
  description={book.data.summary}
  ogImageUrl={book.data.cover ?? undefined}
  pageType="article"
>
  <div class="breadcrumbs">
    <a href="/">~/log</a><span aria-hidden="true">/</span><a href="/books/">books</a><span
      aria-hidden="true">/</span
    ><a href={bookPath(book)}>{book.data.slug}</a><span aria-hidden="true">/</span><strong
      >{chapter.data.slug}</strong
    >
  </div>
  <div class="article-layout book-reader-layout">
    <article
      class="article-page"
      data-reading-progress
      data-reading-book-slug={book.data.slug}
      data-reading-book-title={book.data.title}
      data-reading-book-subtitle={book.data.subtitle}
      data-reading-chapter-title={chapter.data.title}
    >
      <header class="article-header book-chapter-header">
        <div class="post-meta detail">
          <span>{book.data.title}</span><span aria-hidden="true">·</span><span
            >{readingTime} 分钟阅读</span
          >
          <span
            class="post-views"
            data-book-chapter-views={`${book.data.slug}/${chapter.data.slug}`}
            data-state="loading"
            aria-live="polite">— 次访问</span
          >
        </div>
        <h1>
          {titleStart}{
            titleFootnote && (
              <sup class="title-footnote">
                <a
                  href={`#user-content-fn-${titleFootnote.number}`}
                  id={`title-fnref-${titleFootnote.number}`}
                  data-footnote-ref
                  data-footnote-preview-ref
                  aria-describedby="footnote-label"
                >
                  {titleFootnote.number}
                </a>
              </sup>
            )
          }{titleEnd}
        </h1>
        <p class="book-chapter-source">
          第 {String(chapter.data.chapterNumber).padStart(2, '0')} 个阅读单元
        </p>
        {
          parallelChapterPath(book, chapter) && book.data.alternateEditionLabel && (
            <p class="book-chapter-source">
              对照阅读：
              <a class="text-link" href={parallelChapterPath(book, chapter)!}>
                阅读{book.data.alternateEditionLabel}
              </a>
              （同一章）
            </p>
          )
        }
        {book.data.private && <BookShareButton label="复制本章分享链接" />}
      </header>
      <details class="mobile-toc">
        <summary>本书目录</summary>
        <BookToc book={book} chapters={chapters} currentSlug={chapter.data.slug} />
        {headings.length > 0 && <TableOfContents headings={headings} />}
      </details>
      <div class="prose"><Content /></div>
      <BookReaderNav book={book} previous={previous} next={next} />
      <p class="book-source-note">
        本章内容来自<a href={book.data.sourceUrl} target="_blank" rel="noreferrer">
          {book.data.sourceName} ↗
        </a>，转载范围见<a href={bookPath(book)}>图书页说明</a>。
      </p>
    </article>
    <aside class="article-aside">
      <BookToc book={book} chapters={chapters} currentSlug={chapter.data.slug} />
      {headings.length > 0 && <TableOfContents headings={headings} />}
    </aside>
  </div>
  <BookChapterViewCounts />
  <script>
    const readingPage = document.querySelector<HTMLElement>('[data-reading-progress]');
    if (readingPage) {
      try {
        const key = 'tursom-book-progress-v1';
        const saved = JSON.parse(localStorage.getItem(key) ?? '[]');
        const previous = Array.isArray(saved) ? saved : [];
        const bookSlug = readingPage.dataset.readingBookSlug ?? '';
        const current = {
          bookSlug,
          bookTitle: readingPage.dataset.readingBookTitle ?? '',
          bookSubtitle: readingPage.dataset.readingBookSubtitle || undefined,
          chapterTitle: readingPage.dataset.readingChapterTitle ?? '',
          path: location.pathname,
          updatedAt: Date.now(),
        };
        localStorage.setItem(
          key,
          JSON.stringify(
            [
              current,
              ...previous.filter(
                (item) => item && typeof item === 'object' && item.bookSlug !== bookSlug,
              ),
            ].slice(0, 20),
          ),
        );
      } catch {}
    }
  </script>
</SiteLayout>
