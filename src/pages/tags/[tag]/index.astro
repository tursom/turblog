---
import TagView from '@/components/TagView.astro';
import { allTags, getPosts, paginate, tagSlug } from '@/lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return allTags(posts).map(({ name }) => {
    const tagged = posts.filter((post) => post.data.tags.includes(name));
    return { params: { tag: tagSlug(name) }, props: { tag: name, page: paginate(tagged, 1) } };
  });
}

const { tag, page } = Astro.props;
---

<TagView tag={tag} page={page} />
