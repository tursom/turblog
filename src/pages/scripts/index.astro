---
import SiteLayout from '@/layouts/SiteLayout.astro';
import { farmScripts } from '@/lib/farm';

const collections = [
  {
    slug: 'farm',
    title: '编程农场',
    summary:
      '《The Farmer Was Replaced》的综合种植、仙人掌、恐龙与迷宫脚本，附模拟、测试和实验记录。',
    count: farmScripts.length,
    environment: '游戏内脚本 · Python 模拟',
  },
];
---

<SiteLayout title="脚本" description="按用途和项目整理的脚本集合，提供使用说明、完整源码与下载。">
  <div class="breadcrumbs">
    <a href="/">~/log</a><span aria-hidden="true">/</span><strong>scripts</strong>
  </div>
  <header class="page-intro compact-intro">
    <span class="eyebrow">SCRIPTS</span>
    <h1>脚本</h1>
    <p>按用途和项目整理，查看使用说明、复制源码或下载文件。</p>
  </header>
  <section class="section-block" aria-labelledby="script-collections">
    <div class="section-heading"><h2 id="script-collections">脚本集合</h2></div>
    <ul class="script-collections">
      {
        collections.map((collection) => (
          <li>
            <div class="collection-heading">
              <h3>
                <a href={`/scripts/${collection.slug}/`}>{collection.title}</a>
              </h3>
              <span>{collection.count} 个主要脚本</span>
            </div>
            <p>{collection.summary}</p>
            <div class="collection-footer">
              <span>{collection.environment}</span>
              <a class="text-link" href={`/scripts/${collection.slug}/`}>
                浏览脚本 →
              </a>
            </div>
          </li>
        ))
      }
    </ul>
  </section>
</SiteLayout>

<style>
  .script-collections {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .script-collections li {
    padding: 24px 0;
    border-bottom: 1px solid var(--line);
  }
  .collection-heading,
  .collection-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px 24px;
  }
  h3 {
    margin: 0;
    font-size: 21px;
  }
  h3 a:hover {
    color: var(--accent-strong);
  }
  .script-collections p {
    max-width: 780px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.8;
  }
  .collection-heading > span,
  .collection-footer > span {
    color: var(--muted);
    font-size: 13px;
  }
</style>
