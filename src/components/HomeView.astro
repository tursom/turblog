---
import SiteLayout from '@/layouts/SiteLayout.astro';
import { Image } from 'astro:assets';
import PostCard from '@/components/PostCard.astro';
import PostMeta from '@/components/PostMeta.astro';
import TagLinks from '@/components/TagLinks.astro';
import { PAGE_SIZE, postPath, type Post } from '@/lib/posts';

interface Props {
  posts: Post[];
  owner?: boolean;
}

const { posts, owner = false } = Astro.props;
const featured = posts[0];
const latest = posts.slice(1, PAGE_SIZE);
---

<SiteLayout
  title="Tursom Log"
  description="关于软件、系统与长期实践的技术记录。"
  canonicalPath="/"
  noindex={owner}
>
  <div class="breadcrumbs">
    <span>~/log</span><span aria-hidden="true">/</span><strong>latest</strong>
  </div>

  <section class="page-intro">
    <span class="eyebrow">TURSOM'S TECHNICAL NOTES</span>
    <h1>最新技术记录</h1>
    <p>我是 Tursom。这里记录软件工程中的实际问题、证据、实现过程与可以复用的结论。</p>
  </section>

  {
    featured && (
      <article class:list={['featured-post', { 'without-cover': !featured.data.cover }]}>
        {featured.data.cover && (
          <a class="featured-cover" href={postPath(featured)}>
            <Image
              src={featured.data.cover}
              alt={featured.data.title}
              widths={[480, 800, 1200]}
              sizes="(max-width: 780px) calc(100vw - 36px), 42vw"
              loading="lazy"
            />
          </a>
        )}
        <div class="featured-copy">
          <PostMeta post={featured} />
          <h2>
            <a href={postPath(featured)}>{featured.data.title}</a>
          </h2>
          <p>{featured.data.summary}</p>
          <TagLinks tags={featured.data.tags} />
          <a class="text-link" href={postPath(featured)}>
            打开文章 <span aria-hidden="true">→</span>
          </a>
        </div>
      </article>
    )
  }

  <section class="section-block" aria-labelledby="latest-heading">
    <div class="section-heading">
      <div><span class="section-kicker">ARCHIVE</span><h2 id="latest-heading">全部更新</h2></div>
      <a class="quiet-link" href="/archive/">查看归档 <span aria-hidden="true">→</span></a>
    </div>
    <div class="post-list">
      {
        posts.length === 0 ? (
          <p class="empty-state">这里还没有文章。</p>
        ) : (
          latest.map((post) => <PostCard post={post} />)
        )
      }
    </div>
  </section>
</SiteLayout>

<style>
  .featured-post.without-cover {
    grid-template-columns: minmax(0, 1fr);
  }
</style>
