---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
---

{
  headings.length > 0 && (
    <nav class="table-of-contents" aria-label="文章目录">
      <p class="toc-title">本页目录</p>
      <ol>
        {headings.map((heading) => (
          <li style={`--heading-depth: ${Math.max(0, heading.depth - 2)}`}>
            <a href={`#${heading.slug}`}>{heading.text}</a>
          </li>
        ))}
      </ol>
    </nav>
  )
}
