---
import { bookPath, type Book } from '@/lib/books';

interface Props {
  book: Book;
}

const { book } = Astro.props;
---

<article class:list={['book-card', { 'has-cover': Boolean(book.data.cover) }]}>
  {
    book.data.cover && (
      <a class="book-card-cover" href={bookPath(book)}>
        <img
          src={book.data.cover}
          alt={`${book.data.title} 封面`}
          width="1049"
          height="1600"
          sizes="(max-width: 780px) 105px, 156px"
          loading="lazy"
          decoding="async"
        />
      </a>
    )
  }
  <div class="book-card-copy">
    <span class="section-kicker">BOOK</span>
    <h2><a href={bookPath(book)}>{book.data.title}</a></h2>
    {book.data.subtitle && <p class="book-subtitle">{book.data.subtitle}</p>}
    <p>{book.data.summary}</p>
    <div class="book-card-meta">
      <span>{book.data.author}</span>
      <span>{book.data.chapterCount} 个阅读单元</span>
    </div>
    <a class="text-link" href={bookPath(book)}>打开图书 <span aria-hidden="true">→</span></a>
  </div>
</article>
