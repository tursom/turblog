---
import { bookCategoryLabels, bookPath, type Book, type BookGroup } from '@/lib/books';

interface Props {
  group: BookGroup;
}

const { group } = Astro.props;
const representative = group.books.find((book) => book.data.cover) ?? group.books[0];
const authors = [...new Set(group.books.map((book) => book.data.author))];
const isSeries = group.books.length > 1;
const itemLabel = group.category === 'textbook' ? '册' : '个版本';
const headingId = `book-group-${group.slug}`;
const searchText = group.books
  .flatMap((book) => [
    book.data.title,
    book.data.subtitle,
    book.data.author,
    book.data.translator,
    book.data.editionLabel,
    book.data.summary,
  ])
  .filter(Boolean)
  .join(' ');

function editionLabel(book: Book): string {
  return book.data.subtitle ?? book.data.editionLabel ?? book.data.title;
}
---

<article
  class:list={['book-group', { 'has-cover': Boolean(representative.data.cover) }]}
  data-book-group
  data-category={group.category}
  data-search={searchText}
  aria-labelledby={headingId}
>
  {
    representative.data.cover && (
      <a class="book-group-cover" href={bookPath(representative)} tabindex="-1" aria-hidden="true">
        <img
          src={representative.data.cover}
          alt=""
          width="1049"
          height="1600"
          sizes="(max-width: 780px) 82px, 112px"
          loading="lazy"
          decoding="async"
        />
      </a>
    )
  }
  <div class="book-group-copy">
    <div class="book-group-heading">
      <div>
        <span class="section-kicker">{bookCategoryLabels[group.category]}</span>
        <h2 id={headingId}>
          {isSeries ? group.title : <a href={bookPath(group.books[0])}>{group.title}</a>}
        </h2>
      </div>
      <span class="book-group-count">
        {isSeries ? `${group.books.length} ${itemLabel}` : `${group.chapterCount} 个阅读单元`}
      </span>
    </div>
    <p class="book-group-meta">
      {authors.join('、')}
      {isSeries && ` · 共 ${group.chapterCount} 个阅读单元`}
    </p>
    {
      isSeries ? (
        <ul class="book-edition-list" aria-label={`${group.title}包含的图书`}>
          {group.books.map((book) => (
            <li>
              <a href={bookPath(book)} aria-label={`${book.data.title}，${editionLabel(book)}`}>
                <span>{editionLabel(book)}</span>
                <small>{book.data.chapterCount} 个阅读单元</small>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <>
          {group.books[0].data.subtitle && (
            <p class="book-group-subtitle">{group.books[0].data.subtitle}</p>
          )}
          <p class="book-group-summary">{group.books[0].data.summary}</p>
          <a class="text-link" href={bookPath(group.books[0])}>
            打开图书 <span aria-hidden="true">→</span>
          </a>
        </>
      )
    }
  </div>
</article>
