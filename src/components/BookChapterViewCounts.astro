<script is:inline>
  (() => {
    const apiBasePath = document.body.dataset.apiBasePath || '/api/v1';
    const counters = Array.from(document.querySelectorAll('[data-book-chapter-views]'));
    if (counters.length === 0) return;
    /** @type {Map<string, Element[]>} */
    const countersBySlug = new Map();
    counters.forEach((counter) => {
      const slug = counter.getAttribute('data-book-chapter-views');
      if (!slug) return;
      const matches = countersBySlug.get(slug) || [];
      matches.push(counter);
      countersBySlug.set(slug, matches);
    });
    const subjectIds = Array.from(countersBySlug.keys());
    fetch(`${apiBasePath}/analytics/metrics/query`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        metric: 'book_chapter_unique_views',
        subject_type: 'book_chapter',
        subject_ids: subjectIds,
      }),
    })
      .then((response) => {
        if (!response.ok) throw new Error(`metrics request failed with ${response.status}`);
        return response.json();
      })
      .then((payload) => {
        if (
          payload?.metric !== 'book_chapter_unique_views' ||
          !payload.values ||
          typeof payload.values !== 'object'
        )
          throw new Error('invalid metrics response');
        countersBySlug.forEach((matches, slug) => {
          const value = payload.values[slug];
          matches.forEach((counter) => {
            if (!Number.isSafeInteger(value) || value < 0) {
              counter.setAttribute('data-state', 'error');
              return;
            }
            counter.textContent = `${value} 次访问`;
            counter.setAttribute('data-state', 'ready');
          });
        });
      })
      .catch(() => counters.forEach((counter) => counter.setAttribute('data-state', 'error')));
  })();
</script>
